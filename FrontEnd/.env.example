# Server-side URL of the FastAPI backend, used by src/proxy.ts (/backend/* and token rotation) and the /api/auth handlers.
# Compose sets http://backend:8000.
BACKEND_URL=http://localhost:8000
# Mapbox GL JS public token (https://account.mapbox.com/access-tokens). Without it the map is hidden, the list still works.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Realtime voice assistant: WebSocket the browser opens straight to the backend (a Next rewrite is not reliable for
# WebSockets). Default for local dev is ws://<current host>:8000/api/voice/ws. The page origin must be in the
# backend's CORS_ORIGINS. Baked in at build time.
NEXT_PUBLIC_VOICE_WS_URL=
# Realtime voice assistant: microphone auto gain control, on by default. It helps when the phone lies far from the
# caller but also amplifies background voices, so "0" or "false" turns it off for field A/B tests. Baked in at build time.
NEXT_PUBLIC_VOICE_AGC=
# "Tìm kiếm người hỗ trợ": WebSocket the browser opens straight to the backend, like the voice one. Default for local dev
# is ws://<current host>:8000/api/support/ws; set wss://…/api/support/ws behind HTTPS / tunnels. Baked in at build time.
NEXT_PUBLIC_SUPPORT_WS_URL=
# Demo only: "true" shows a picker on the support pages to pretend each browser tab stands at a preset place in
# District 1, so a requester and a responder in two windows of one computer are a few hundred metres apart.
NEXT_PUBLIC_DEMO_LOCATION=
# Firebase web app config for phone sign-up / password reset by SMS OTP (Firebase console > Project settings > Your apps).
# These are public identifiers, not secrets. Enable Authentication > Sign-in method > Phone and add the site's domain
# under Authentication > Settings > Authorized domains. Baked in at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
