# Server-side URL of the FastAPI backend (used by the /backend/* rewrite). Compose sets http://backend:8000.
BACKEND_URL=http://localhost:8000
# Mapbox GL JS public token (https://account.mapbox.com/access-tokens). Without it the map is hidden, the list still works.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Realtime voice assistant: WebSocket the browser opens straight to the backend (a Next rewrite is not reliable for
# WebSockets). Default for local dev is ws://<current host>:8000/api/voice/ws. The page origin must be in the
# backend's CORS_ORIGINS. Baked in at build time.
NEXT_PUBLIC_VOICE_WS_URL=
# Realtime voice assistant: microphone auto gain control, on by default. It helps when the phone lies far from the
# caller but also amplifies background voices, so "0" or "false" turns it off for field A/B tests. Baked in at build time.
NEXT_PUBLIC_VOICE_AGC=
