DATABASE_URL=postgresql+psycopg://esmarch:esmarch@localhost:5432/esmarch
CORS_ORIGINS=http://localhost:3000
REQUIRE_HTTPS=false
FACILITIES_DATA_FILE=data/seeds/facilities.json
GUIDES_DATA_FILE=data/seeds/guides.json
AEDS_DATA_FILE=data/seeds/aeds.json
# >= 32 random chars to enable responder administration
SUPPORT_ADMIN_TOKEN=
# "Tìm kiếm người hỗ trợ": search radius in metres, and demo self-enrolment of signed-in users as responders without
# admin verification (the "Sẵn sàng hỗ trợ" page). Never enable self-enrolment in production.
SUPPORT_RADIUS_METERS=3000
SUPPORT_DEMO_SELF_ENROLL=false
# Optional FCM service-account JSON (one-line JSON). Keep the real credential only in BackEnd/.env or a secret store.
FCM_SERVICE_ACCOUNT_JSON=
PUBLIC_API_RATE_LIMIT_REQUESTS=60
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_API_MAX_CLIENTS=10000


# Voice assistant tuning: talking speed (0.25-1.5) and end-of-turn silence in ms (lower = replies sooner)

OPENAI_API_KEY=
VOICE_LIVE_MODEL=gpt-live-1
VOICE_LIVE_BACKEND=gpt-6-luna
VOICE_LIVE_VOICE=marin
VOICE_LIVE_TURN_SILENCE_MS=1200
VOICE_SESSION_SECONDS=600
# Seconds before the limit at which the caller is warned (0 = no warning)
VOICE_END_WARNING_SECONDS=60
# Seconds a call survives a dropped browser WebSocket, waiting for it to resume (0 = a drop ends the call)
VOICE_RESUME_GRACE_SECONDS=20

# Accounts: JWT access tokens (15 min) + rotating refresh tokens (30 days). Auth endpoints answer 503 until this is set.
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Confirmation / password-reset codes are emailed through Resend (https://resend.com/api-keys).
RESEND_API_KEY=
# A sender on a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
RESEND_FROM=SOS NOW <onboarding@resend.dev>
# Local development without Resend: print the email (with the code) to the backend log instead. Never enable in production.
AUTH_DEV_LOG_CODES=false

# Phone sign-up / password reset: the browser verifies the number with Firebase Phone Auth (SMS OTP) and the backend
# checks the resulting ID token. The Firebase project id (Project settings > General). Phone endpoints answer 503 until set.
FIREBASE_PROJECT_ID=
