DATABASE_URL=postgresql+psycopg://esmarch:esmarch@localhost:5432/esmarch
CORS_ORIGINS=http://localhost:3000
REQUIRE_HTTPS=false
FACILITIES_DATA_FILE=data/seeds/facilities.json
GUIDES_DATA_FILE=data/seeds/guides.json
AEDS_DATA_FILE=data/seeds/aeds.json
# >= 32 random chars to enable responder administration
SUPPORT_ADMIN_TOKEN=
# "Tìm kiếm người hỗ trợ": search radius in metres, and demo self-enrolment of signed-in users as responders without
# admin verification (the "Sẵn sàng hỗ trợ" page). Never enable self-enrolment in production.
SUPPORT_RADIUS_METERS=3000
SUPPORT_DEMO_SELF_ENROLL=false
# Scene video per request (default 25 MB). The browser uploads it straight to the Supabase bucket, whose file size
# limit must allow it.
SUPPORT_VIDEO_MAX_BYTES=26214400
PUBLIC_API_RATE_LIMIT_REQUESTS=60
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_API_MAX_CLIENTS=10000


# Voice assistant tuning: talking speed (0.25-1.5) and end-of-turn silence in ms (lower = replies sooner)

OPENAI_API_KEY=
# Voice description in "Tìm người hỗ trợ": shown in the form whenever OPENAI_API_KEY is set
SUPPORT_TRANSCRIBE_MODEL=gpt-transcribe
VOICE_LIVE_MODEL=gpt-live-1
VOICE_LIVE_BACKEND=gpt-6-luna
VOICE_LIVE_VOICE=marin
VOICE_LIVE_TURN_SILENCE_MS=1200
VOICE_SESSION_SECONDS=600
# Seconds before the limit at which the caller is warned (0 = no warning)
VOICE_END_WARNING_SECONDS=60
# At most this many calls at once (each one is a paid OpenAI session) and new calls per IP per rate-limit window
VOICE_MAX_SESSIONS=5
VOICE_CONNECTS_PER_WINDOW=6
# The cost cap does not trust the browser: GET /api/voice/reap hangs up calls past VOICE_SESSION_SECONDS, calls whose
# browser stopped sending heartbeats and calls whose hand-over is done. Run it every minute with
# `Authorization: Bearer <CRON_SECRET>` (Vercel Cron on Pro, or Supabase pg_cron + pg_net on any plan). New calls also
# run it. At least 16 random characters.
CRON_SECRET=
# Header the frontend proxy puts the caller's IP in. Set only when the backend is reached through that proxy alone.
CLIENT_IP_HEADER=

# Accounts live in Supabase Auth. The backend verifies Supabase access tokens (Authorization: Bearer) against the
# project's public signing keys at <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Signed-in endpoints answer 503 until set.
SUPABASE_URL=

# Server-only Supabase service key (Project Settings > API, the secret key; never expose it to the browser). With it,
# request photos go to a private Storage bucket (create "support-photos", private) and live updates are sent through
# Realtime Broadcast. Without it photos stay in process memory and the support pages poll every 3 s (dev only).
SUPABASE_SERVICE_KEY=
SUPABASE_PHOTO_BUCKET=support-photos

# Signs lesson quiz tokens ("Khóa học sơ cứu"). Optional: empty = SUPABASE_SERVICE_KEY, else a random key per process.
COURSE_QUIZ_SECRET=
